# -------------------------------------------
#  NabhRakshak — Root .gitignore
#  Covers: React/Vite frontend + Python/Flask backend
# -------------------------------------------
# -- Node / Frontend --------------------------
node_modules/
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
frontend/.vite/
*.local
# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
# -- Python / Backend -------------------------
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
*.pyc
*.pyo
*.pyd
# Virtual environments
backend/venv/
backend/.venv/
venv/
.venv/
env/
# Distribution / packaging
*.egg
*.egg-info/
dist/
build/
.eggs/
*.whl
# Unit test / coverage
.coverage
.coverage.*
htmlcov/
.pytest_cache/
.tox/
nosetests.xml
coverage.xml
# -- Environment / Secrets --------------------
.env
.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env
# -- Generated / Runtime data -----------------
backend/data/cache.json
backend/data/reports/
backend/services/alerts.csv
# -- Editors and OS ---------------------------
.DS_Store
Thumbs.db
desktop.ini
# VSCode
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
# JetBrains IDEs
.idea/
*.iml
# Windows
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
# -- Docker -----------------------------------
docker-compose.override.yml
# -- Misc -------------------------------------
.cache/
.vercel/
.netlify/
*.zip
*.tar.gz
yarn.lock